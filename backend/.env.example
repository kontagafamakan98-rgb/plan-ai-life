# ARCADIA-9 backend — example configuration.
# Copy to `.env` only if you want to override the defaults:
#     cp .env.example .env
# Every value below is optional: with no `.env` at all the backend runs on the
# local JSON save file and needs no database or API key.

# --- Persistence -----------------------------------------------------------
# Leave MONGO_URL unset (or blank) to use the atomic local save file.
# Set it to switch to MongoDB; if it is set but unreachable the backend logs a
# warning and keeps playing on the local save.
# MONGO_URL=mongodb://127.0.0.1:27017
# DB_NAME=arcadia9
# ARCADIA_DATA_DIR=./data

# --- Security --------------------------------------------------------------
# Optional. When omitted a random secret is generated at start-up, which means
# users must log in again after each restart. Set it for persistent sessions.
# JWT_SECRET=change-me-to-a-long-random-string

# --- Optional integrations (the game is fully playable without them) -------
# STRIPE_SECRET_KEY=
# FRONTEND_URL=http://localhost:8081
