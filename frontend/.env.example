# ARCADIA-9 frontend — example configuration.
# Copy to `.env` before starting Expo:
#     cp .env.example .env
#
# Expo only exposes variables prefixed with EXPO_PUBLIC_ to the app bundle.

# Base URL of the backend.
#   - Local development:  http://127.0.0.1:8000
#   - Expo Go on a phone:  http://<your-computer-LAN-IP>:8000
EXPO_PUBLIC_BACKEND_URL=http://127.0.0.1:8000
